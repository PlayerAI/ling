{
  "name": "tree-sitter-ling",
  "version": "0.0.1-dev",
  "description": "Tree-sitter grammar for the Ling programming language",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlayerAI/ling.git",
    "directory": "editors/tree-sitter-ling"
  },
  "keywords": [
    "incremental",
    "ling",
    "parser",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "queries/**",
    "src/**",
    "test/corpus/**",
    "test/fixtures/brackets/**",
    "test/highlight/**",
    "examples/**"
  ],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test && npm run test:scanner && npm run test:layout && npm run test:unicode && npm run test:precedence && npm run test:pattern-types && npm run test:recovery && npm run test:conformance && npm run test:highlights && npm run test:brackets",
    "test:brackets": "node test/run-bracket-tests.js",
    "test:conformance": "node test/run-conformance-differential.js",
    "test:highlights": "node test/run-highlight-tests.js",
    "test:layout": "node test/run-layout-integration.js",
    "test:scanner": "node test/run-scanner-tests.js",
    "test:unicode": "node test/run-unicode-differential.js",
    "test:precedence": "node test/run-precedence-differential.js",
    "test:pattern-types": "node test/run-pattern-type-differential.js",
    "test:recovery": "node test/run-recovery-integration.js",
    "parse:examples": "tree-sitter parse \"examples/*.ling\"",
    "verify": "npm run generate && npm test && npm run parse:examples"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.12"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "tree-sitter-cli@0.26.12": true
  }
}
