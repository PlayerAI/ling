{
  "grammars": [
    {
      "name": "ling",
      "camelcase": "Ling",
      "scope": "source.ling",
      "path": ".",
      "file-types": [
        "ling"
      ],
      "injection-regex": "^ling$"
    }
  ],
  "metadata": {
    "version": "0.0.1-dev",
    "license": "Apache-2.0",
    "description": "Tree-sitter grammar for the Ling programming language",
    "authors": [
      {
        "name": "PlayerAI contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/PlayerAI/ling"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
