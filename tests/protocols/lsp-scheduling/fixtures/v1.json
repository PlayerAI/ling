    "textDocument/diagnostic": "analysis",
    "textDocument/hover": "interactive",
    "textDocument/prepareRename": "interactive",
    "textDocument/references": "interactive",
    "textDocument/rename": "interactive",
    "textDocument/semanticTokens/full": "analysis",
    "textDocument/semanticTokens/full/delta": "analysis",
    "textDocument/typeDefinition": "interactive",
    "workspace/diagnostic": "analysis",
    "workspace/symbol": "background"
  }
