      "capability": "Native code generation, stable ABI, FFI, or target artifacts",
      "reason": "Ownership, target, ABI, and FFI contracts are unresolved and unimplemented.",
      "blockers": [
        "GAP-OWNERSHIP-MODEL-001",
        "GAP-NATIVE-BACKEND-ABI-001"
      ],
      "sources": [
        "docs/governance/gap-register.toml"
      ]
    },
    {
      "id": "UNSUP-PACKAGES",
      "area": "Project/package",
      "capability": "Package installation, publication, or registry distribution",
      "reason": "Accepted DEC-0228 defers registry behavior through Ling 1.0. RFC-0002 local manifest, content identity, vendored dependency, project-check, and lock workflows remain available at their recorded stability, while publication, installation, and registry distribution remain Unsupported.",
      "blockers": [],
      "sources": [
        "docs/RFC-0002.md",
        "docs/decisions/0228-registry-deferred-through-v1.md",
        "docs/ling_execution_plan/10-G6-V1.0-STABILIZATION.md"
      ]
    },
    {
      "id": "UNSUP-PROFILE-SELECTION",
