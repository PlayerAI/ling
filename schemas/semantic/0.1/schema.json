{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ling:schema:semantic:0.1",
  "title": "Ling Semantic Graph JSON 0.1",
  "type": "object",
  "required": [
    "schema",
    "language_version",
    "unicode_version",
    "program_id",
    "entry_module",
    "modules",
    "definitions",
    "references"
  ],
  "properties": {
    "schema": { "const": "ling.semantic/0.1" },
    "language_version": { "type": "string" },
    "unicode_version": { "type": "string" },
    "program_id": { "type": "string" },
    "entry_module": { "type": "string" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "definitions": { "type": "array", "items": { "$ref": "#/$defs/definition" } },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "x-ling-actor": { "$ref": "#/$defs/actorProjection" }
  },
  "patternProperties": { "^x-": true },
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "required": ["name", "explicit", "requires", "imports"],
      "properties": {
        "name": { "type": "string" },
        "explicit": { "type": "boolean" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/import" } }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "required": ["alias", "module"],
      "properties": {
        "alias": { "type": "string" },
        "module": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": ["definition_id", "body_id", "module", "name", "kind", "origin", "type", "effects", "capabilities"],
      "properties": {
        "definition_id": { "type": "string" },
        "body_id": { "type": "string" },
        "module": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "origin": { "type": "string" },
        "type": { "type": "string" },
        "effects": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["node_id", "module", "kind", "owner", "effects", "capabilities", "identifier_scripts", "identifier_suspicious_mixed_script"],
      "properties": {
        "node_id": { "type": "string" },
        "module": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "type": { "type": "string" },
        "mutable": { "type": "boolean" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "effects": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "identifier_source": { "type": "string" },
        "identifier_skeleton": { "type": "string" },
        "identifier_scripts": { "type": "array", "items": { "type": "string" } },
        "identifier_suspicious_mixed_script": { "type": "boolean" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    },
    "actorProjection": {
      "type": "object",
      "required": ["version", "actors"],
      "properties": {
        "version": { "const": "0.3" },
        "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["definition_id", "message_type", "sendability", "schema_id", "root", "span", "mailbox", "turn", "nodes"],
      "properties": {
        "definition_id": { "type": "string" },
        "message_type": { "type": "string", "minLength": 1 },
        "sendability": { "const": "SendableLocal(Value)" },
        "schema_id": { "type": "string" },
        "root": { "type": "integer", "minimum": 0 },
        "span": { "$ref": "#/$defs/byteSpan" },
        "mailbox": { "$ref": "#/$defs/actorMailbox" },
        "turn": { "$ref": "#/$defs/actorTurn" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/actorNode" } }
      },
      "additionalProperties": false
    },
    "actorMailbox": {
      "type": "object",
      "required": ["capacity", "overflow", "canonical_bytes", "span", "capacity_span", "policy_span"],
      "properties": {
        "capacity": { "type": "integer", "minimum": 1 },
        "overflow": { "const": "Reject" },
        "canonical_bytes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "span": { "$ref": "#/$defs/byteSpan" },
        "capacity_span": { "$ref": "#/$defs/byteSpan" },
        "policy_span": { "$ref": "#/$defs/byteSpan" }
      },
      "additionalProperties": false
    },
    "actorTurn": {
      "type": "object",
      "required": ["actor_type", "dispatch", "suspension", "reentry", "state_commit", "self_send", "transition", "state_binding", "message_binding", "canonical_bytes", "span", "body_span"],
      "properties": {
        "actor_type": { "type": "integer", "minimum": 1 },
        "dispatch": { "const": "OneMessage" },
        "suspension": { "const": "Forbidden" },
        "reentry": { "const": "Forbidden" },
        "state_commit": { "const": "PublishOnNormalReturn" },
        "self_send": { "const": "MailboxOnly" },
        "transition": { "type": "integer", "minimum": 0 },
        "state_binding": { "type": "integer", "minimum": 0 },
        "message_binding": { "type": "integer", "minimum": 0 },
        "canonical_bytes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "span": { "$ref": "#/$defs/byteSpan" },
        "body_span": { "$ref": "#/$defs/byteSpan" }
      },
      "additionalProperties": false
    },
    "actorNode": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["primitive", "tuple", "list", "record", "variant"] },
        "name": { "type": "string" },
        "definition": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "elements": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "element": { "type": "integer", "minimum": 0 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/actorField" } },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/actorCase" } }
      },
      "additionalProperties": false
    },
    "actorField": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "actorCase": {
      "type": "object",
      "required": ["definition", "name", "payload"],
      "properties": {
        "definition": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "payload": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "byteSpan": {
      "type": "object",
      "required": ["source", "start", "end"],
      "properties": {
        "source": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["module", "reference", "target_kind", "target"],
      "properties": {
        "module": { "type": "string" },
        "source_kind": { "type": "string" },
        "reference": { "type": "integer", "minimum": 0 },
        "source_id": { "type": "string" },
        "target_kind": { "type": "string" },
        "target": { "type": "string" }
      },
      "patternProperties": { "^x-": true },
      "additionalProperties": false
    }
  }
}
