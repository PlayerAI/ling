{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ling:schema:semantic-query:0.1",
  "title": "Ling Semantic Query response 0.1",
  "type": "object",
  "required": ["schema", "semantic_schema", "language_version", "unicode_version", "program_id", "symbol", "matches"],
  "properties": {
    "schema": { "const": "ling.semantic-query/0.1" },
    "semantic_schema": { "const": "ling.semantic/0.1" },
    "language_version": { "const": "0.0.1-dev" },
    "unicode_version": { "const": "17.0.0" },
    "program_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["definition_id", "body_id", "module", "name", "kind", "type", "effects", "capabilities"],
        "properties": {
          "definition_id": { "type": "string", "minLength": 1 },
          "body_id": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "effects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
